situation_panel = {

	##################################### TOP HEADER #####################################

	# ORIGIN
	blockoverride "situation_header_left" {
		icon = {
			size = {32 32}
			texture = "gfx/interface/icons/pops/laborers.dds"
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				fontsize = 15
				text = "NW_DUSK_OF_THE_OLD_WORLD_MIGRATED_POPS"
				default_format = "#subtle_name"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 13
				text = "[Player.MakeScope.GetVariable('dusk_of_the_old_world_migrated_pops').GetValue|1]"
			}

			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" {
						text = "NW_DUSK_OF_THE_OLD_WORLD_MIGRATED_POPS"
					}
					blockoverride "title_icon" {
						icon = {
							using = tooltip_title_icon_size
							texture = "gfx/interface/icons/pops/laborers.dds"
						}
					}
					blockoverride "tooltip_content" {
						TooltipTextBlock = {
							blockoverride "text" {
								text = "NW_DUSK_OF_THE_OLD_WORLD_MIGRATED_POPS_DESC"
							}
						}
					}
				}
			}
		}
		expand = {}

	}

	# TOTAL DEATHS
	blockoverride "situation_header_right" {
		
	}

	##################################### MAIN IMAGE #####################################

	
	##################################### TAB NAME #####################################

	

	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content"{}

	##################################### MAIN CONTENT #####################################

	blockoverride "situation_panel_main_content" {

		# Gameplay Advice
		situation_card_common = {
			blockoverride "card_datacontext" {}
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/subject_types/colonial_nation.dds"
			}
			blockoverride "common_header_text" {
				text = "NW_DUSK_OF_THE_OLD_WORLD_INFO_HEADER"
			}
			blockoverride "common_bottom_content" {
				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					raw_text = "NW_DUSK_OF_THE_OLD_WORLD_INFO_TEXT"
				}
				expand = {}
			}
			
		}

		# End Requirements
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_CONDITION"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				text_multi = {
					autoresize = no
					multiline = yes
					size = { 400 60 }
					text = "NW_DUSK_OF_THE_OLD_WORLD_END_CONDITION_TEXT"
				}
			}
			blockoverride "visible_hint" {}
			blockoverride "onaction_hint" {
				action_tooltip = {
					title = "OPEN_HINT"
					on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_nw_dusk_of_the_old_world')]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}

		# Building Explanation
		situation_card_common = {
			blockoverride "card_datacontext" {}
			blockoverride "common_header_icon_texture" {
				texture = "gfx/interface/icons/subject_types/imperial_free_city.dds"
			}
			blockoverride "common_header_text" {
				text = "NW_DUSK_OF_THE_OLD_WORLD_DURING_EVENT_INFO_HEADER"
			}
			blockoverride "common_bottom_content" {
				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					raw_text = "NW_DUSK_OF_THE_OLD_WORLD_DURING_EVENT_INFO_TEXT"
				}
				expand = {}
			}
			
		}
		

		
}

}
